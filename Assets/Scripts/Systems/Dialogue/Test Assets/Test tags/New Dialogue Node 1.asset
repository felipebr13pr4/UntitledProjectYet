    m_autoSkip: 0
    m_delay: 0
    m_unskippable: 0
  - m_text: Anyways, here is two things at once! <sound=0><speed=0.2> hopefully this
      worked properly. To be sure...
    m_expression:
      m_assignedExpression: 0
      m_hasFullBody: 0
    m_voice:
